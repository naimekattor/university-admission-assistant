# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admission_db

# ==========================================
# AI Provider Selection: 'groq' | 'gemini' | 'auto'
# ==========================================
AI_PROVIDER=groq

# ==========================================
# Groq AI Configuration (Primary Fast Chat Model)
# ==========================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# Google Gemini AI Configuration (Primary Embeddings with Rate Limiting)
# ==========================================
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# ==========================================
# Vector Search Embeddings Pipeline
# Primary: 'gemini' (Rate-limited, throttled to 14 RPM max)
# Fallback: 'huggingface' (Free Cloud Inference API)
# Local Fallback: 'ollama' with 'bge-m3'
# ==========================================
EMBEDDING_PROVIDER=gemini
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Local Ollama Embeddings (BAAI/bge-m3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# ==========================================
# OCR & PDF Processing Configuration
# ==========================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=ben+eng

# ==========================================
# Admin & Security
# ==========================================
ADMIN_PASSWORD=admin
ADMIN_SECRET=eduguide_admin_secure_secret_2026
JWT_SECRET=eduguide_secret_jwt_key_2026

# ==========================================
# Server & Cache Configuration
# ==========================================
PORT=4000
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
REVALIDATION_SECRET=eduguide_revalidation_secure_secret_2026


# ── Cloudinary (Primary) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── ImgBB (Secondary Fallback) ──
IMGBB_API_KEY=your_imgbb_api_key

# ==========================================
# Render.com 24/7 Keep-Alive Cron Configuration
# ==========================================
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=*/14 * * * *
# BACKEND_URL=https://your-service.onrender.com
# KEEP_ALIVE_URL=https://your-service.onrender.com

