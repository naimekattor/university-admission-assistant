# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/admission_db

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=optional_api_key
QDRANT_COLLECTION_PREFIX=uaa_

# AI Provider Configuration
# Options: 'auto' (Try OpenAI -> Gemini -> Grok -> Ollama fallback), 'openai', 'gemini', 'grok', 'ollama'
AI_PROVIDER=auto

# OpenAI API Key (Primary Cloud)
OPENAI_API_KEY=

# Google Gemini API Key (Secondary Cloud / Vision Extractor)
GEMINI_API_KEY=

# xAI Grok API Key (Tertiary Cloud)
GROK_API_KEY=

# Ollama Local Configuration (Offline Fallback - qwen2.5:7b or qwen2.5:14b recommended for Bangla accuracy)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llama3.2-vision

# Node Environment
NODE_ENV=development
