# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admission_db

# ==========================================
# AI Provider Selection: 'groq' | 'gemini' | 'auto'
# ==========================================
AI_PROVIDER=groq

# ==========================================
# Groq AI Configuration (Primary Fast Chat Model)
# ==========================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# Google Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ==========================================
# Bengali & English Vector Search Embeddings
# Options:
# 1. 'google' with 'text-embedding-004' (Google Free Tier, 768-dim)
# 2. 'ollama' with 'bge-m3' (BAAI/bge-m3 Local Free, State-of-the-Art)
# ==========================================
EMBEDDING_PROVIDER=google
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# Local Ollama Embeddings (BAAI/bge-m3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# ==========================================
# OCR & PDF Processing Configuration
# ==========================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=ben+eng

# ==========================================
# Admin & Security
# ==========================================
ADMIN_PASSWORD=admin
ADMIN_SECRET=eduguide_admin_secure_secret_2026
JWT_SECRET=eduguide_secret_jwt_key_2026

# ==========================================
# Server Configuration
# ==========================================
PORT=4000
NODE_ENV=development
